# ---- Server ----
PORT=43787
HOST=127.0.0.1

# ---- Workspace ----
# Absolute path to the folder you want the editor and the AI to work in.
# Leave empty to use ./workspace.
# You can also set this from the UI (saved to config.json, which wins over this value).
WORKSPACE_DIR=

# ---- Auth ----
# Fixed token. Leave empty to auto-generate one into .token on first start.
AUTH_TOKEN=

# Skip token auth entirely. Only for local testing.
# NEVER enable this while a public tunnel is running.
OPEN_MODE=false

# ---- Limits ----
MAX_FILE_BYTES=2097152
MAX_TREE_ENTRIES=5000

# Optional: restrict which file types can be written (comma separated).
# Leave commented out to allow the built-in list.
# ALLOWED_EXTENSIONS=.html,.css,.js,.json,.md,.txt,.svg
